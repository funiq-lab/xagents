{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XAgents",
  "version": "0.1.0",
  "identifier": "com.yellin.xagents",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:8888/zh_CN",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "XAgents",
        "width": 1024,
        "height": 768,
        "url": "/zh_CN.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
